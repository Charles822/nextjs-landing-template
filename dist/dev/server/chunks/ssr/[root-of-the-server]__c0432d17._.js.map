rk","title":"Réseau actif","description":"Partenariats avec entreprises, cabinets de recrutement et réseaux professionnels pour faciliter votre transition."}]},"services":{"sectionLabel":"Nos Expertises","headline":"5 expertises pour","headlineHighlight":"votre évolution.","benefitsTitle":"Pourquoi faire appel à nous ?","benefits":[{"title":"Certification Qualiopi","description":"Bilans de compétences certifiés, conformes aux exigences de qualité officielles."},{"title":"Équipe expérimentée","description":"Trois consultantes associées avec des expertises complémentaires et une approche humaine."},{"title":"Accompagnement personnalisé","description":"Pas de parcours standardisé. Chaque bilan est adapté à votre situation et vos objectifs."}],"items":[{"id":"bilan-competences","icon":"ClipboardList","title":"Bilan de compétences","description":"Prenez du recul sur votre parcours, identifiez vos leviers de développement et définissez un projet professionnel aligné avec vos aspirations.","cta":"En savoir plus","image":"/lacourcelle-associes/service-bilan-competences.png"},{"id":"outplacement","icon":"Briefcase","title":"Outplacement","description":"Accompagnement personnalisé après une rupture conventionnelle ou un licenciement. Redonnez du sens à votre recherche et sécurisez votre transition.","cta":"En savoir plus","image":"/lacourcelle-associes/service-outplacement.png"},{"id":"validation-potentiel","icon":"Target","title":"Validation de potentiel","description":"Évaluez vos compétences et votre adéquation à un poste ou un secteur cible. Un diagnostic objectif pour des décisions éclairées.","cta":"En savoir plus","image":"/lacourcelle-associes/service-validation-potentiel.png"},{"id":"creation-entreprise","icon":"Rocket","title":"Création d'entreprise","description":"De l'idée au projet concret : structuration, étude de marché, business plan. Vous accompagner dans votre entrepreneuriat.","cta":"En savoir plus","image":"/lacourcelle-associes/service-creation-entreprise