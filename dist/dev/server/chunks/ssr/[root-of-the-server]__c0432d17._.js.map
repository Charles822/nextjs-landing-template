ROC Finance"},{"quote":"Vos compétences ont été bénéfiques pour notre direction et société. Vos expériences passées nous ont permis d'aborder les problèmes différemment et d'apporter de nouveaux éclairages.","author":"Chief Financial Officer","role":"CFO","company":"Arquus"}]},"partners":{"sectionLabel":"Ils nous font confiance","headline":"Nos clients","headlineHighlight":"des secteurs variés.","items":[{"name":"Sacem","logo":"/xtep/logo-sacem.png","description":"Société des auteurs, compositeurs et éditeurs de musique"},{"name":"Somfy","logo":"/xtep/logo-somfy.png","description":"Leader mondial de la domotique"},{"name":"Believe","logo":"/xtep/logo-believe.png","description":"Groupe digital de distribution musicale"},{"name":"Herrenknecht","logo":"/xtep/logo-herrenknecht.png","description":"Leader mondial des tunneliers"},{"name":"Le Conservateur","logo":"/xtep/logo-conservateur.png","description":"Groupe de protection sociale"},{"name":"Académie Nancy-Metz","logo":"/xtep/logo-academie-nancy.png","description":"Académie de Nancy-Metz"}]},"partnersMarquee":["Sacem","Somfy","Believe","Herrenknecht","Nancy-Metz","Courbevoie"],"contact":{"sectionLabel":"Contact","headline":"Optimisez votre performance avec XTEP","intro":"Premier rendez-vous gratuit pour faire le point sur vos besoins et identifier les leviers d'amélioration.","introBold":"Réponse sous 24h."},"footer":{"description":"Cabinet de Conseil en Gestion d'Entreprise. Double expertise métier et technique. Votre Data BI Partner.","copyright":"XTEP"}}